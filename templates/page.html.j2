<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  {#- 콘텐츠 보안 정책(CSP)은 <meta>가 아니라 Vercel 응답 헤더로 보낸다(docs/vercel.json).
      <meta>로 두면 Chrome이 미리 읽기(preload scanner)를 꺼서 파일을 하나씩 차례로 받는다. #}
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <link rel="icon" type="image/webp" href="{{ logo_prefix }}logos/%ED%8C%8C%EB%B9%84%EC%BD%98.webp">
  <link rel="apple-touch-icon" href="{{ logo_prefix }}apple-touch-icon.png">
  {#- 모바일 주소창 색: 페이지 바탕 #}
  <meta name="theme-color" content="#f4f5f7">
  {% if json_ld %}
  {#- 검색엔진이 읽는 사이트 정보(JSON-LD). 실행되는 스크립트가 아니라 데이터라 CSP에 걸리지 않는다. #}
  <script type="application/ld+json">{{ json_ld }}</script>
  {% endif %}
  <link rel="preload" href="{{ font_url }}" as="font" type="font/woff2" crossorigin>
  {%- if supabase_origin %}
  <link rel="preconnect" href="{{ supabase_origin }}" crossorigin>
  {%- endif %}
  <style>
    @font-face { font-family: 'Pretendard Variable'; font-weight: 45 920; font-style: normal; font-display: swap; src: url('{{ font_url }}') format('woff2-variations'); }
  </style>
  <link rel="stylesheet" href="{{ logo_prefix }}style.css?v={{ style_version }}">
</head>
<body>
<main>
  <h1 class="sr-only">{{ title }}</h1>
  {#- 한 줄: 사이트 이름 · 날짜·지표 · 선수 검색 … 집계 안내 · (팀/개인 화면이면 돌아가기) · 이미지 저장.
      한 줄에 안 들어가면 사이트 이름·단추가 첫 줄, 그 아래 날짜·지표·선수 검색과 집계 안내(app.js의 fitTopBar, style.css의 .is-stacked) #}
  <div class="top-bar">
      <div class="top-brand">
        <img class="top-logo" src="{{ logo_prefix }}logos/파비콘.webp" alt="">
        <span class="top-brand-text">
          <span class="top-brand-name">시너지</span>
          <span class="top-brand-sub">스타대학</span>
        </span>
      </div>
      <div class="top-controls">
      <div class="top-pickers">
      <div class="month-select-group">
        {#- 날짜·지표 칸: 버튼을 누르면 그 칸 폭에 맞춘 목록이 칸 바로 아래에 뜬다 #}
        <div class="picker-cell date-cell">
          <button id="calendar-btn" class="top-pick-btn" type="button" aria-haspopup="menu" aria-expanded="false" aria-controls="date-menu"></button>
          {#- 달마다 최신·최종 날짜 바로가기 + 달력(app.js의 renderDateMenu·renderCalendar) #}
          <div id="date-menu" class="pick-menu" role="menu" hidden></div>
        </div>
        {% if not is_profile %}
        <span class="top-picker-sep" aria-hidden="true"></span>
        <div class="picker-cell">
          <button id="metric-btn" class="top-pick-btn" type="button" aria-label="지표" aria-haspopup="menu" aria-expanded="false" aria-controls="metric-menu"></button>
          <div id="metric-menu" class="pick-menu" role="menu" hidden></div>
        </div>
        {% endif %}
      </div>
      {% if not is_profile %}
      <div class="player-search-box">
        <svg class="player-search-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
        <input type="search" id="player-search" class="player-search" placeholder="선수 검색" aria-label="선수 검색" aria-controls="player-search-results" aria-expanded="false" autocomplete="off">
        <div id="player-search-results" class="player-search-results" hidden></div>
      </div>
      {% endif %}
      </div>
      <span class="top-meta" id="top-meta-text"></span>
      </div>
      <div class="top-actions">
      {% if is_profile %}
      <a href="{{ logo_prefix }}index.html" id="back-link" class="top-pill back-link"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>뒤로가기</a>
      {% elif is_team %}
      <a href="{{ logo_prefix }}index.html" id="back-link" class="top-pill back-link"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>전체페이지</a>
      {% endif %}
      {% if not is_profile %}
      <button id="png-btn" class="top-pill png-btn" type="button" title="지금 보이는 표를 PNG 이미지로 내려받습니다"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m0 0l-4-4m4 4l4-4M5 20h14"/></svg>이미지 저장</button>
      {% endif %}
      </div>
  </div>

  {% if is_profile %}
  <div class="profile-wrap">
    <div class="team-card" id="profile-card" style="display:none;">
      <div class="team-card-topbar" id="profile-topbar"></div>
      <div class="team-header">
        <div class="team-header-left">
          <img class="profile-photo-img" id="profile-photo" alt="" data-fallback="hidden">
          <span class="team-name" id="profile-nickname"></span>
        </div>
      </div>
      <div id="profile-live-embed" style="display:none;"></div>
      <div>
        <div class="profile-row"><span class="profile-row-label">성별</span><span class="profile-row-value" id="profile-gender"></span></div>
        <div class="profile-row"><span class="profile-row-label">생년월일</span><span class="profile-row-value" id="profile-birthdate"></span></div>
        <div class="profile-row"><span class="profile-row-label">소속</span><span class="profile-row-value" id="profile-team"></span></div>
        <div class="profile-row"><span class="profile-row-label">직책</span><span class="profile-row-value" id="profile-role"></span></div>
        <div class="profile-row"><span class="profile-row-label">종족</span><span class="profile-row-value" id="profile-race"></span></div>
        <div class="profile-row"><span class="profile-row-label">티어</span><span class="profile-row-value" id="profile-tier"></span></div>
        <div class="profile-row">
          <span class="profile-row-label">방송국</span>
          <a id="profile-station-link" href="#" target="_blank" rel="noopener">
            <img class="profile-station-icon" src="{{ logo_prefix }}logos/숲로고.webp" alt="방송국 바로가기" data-fallback="none">
          </a>
        </div>
      </div>
      <div class="team-footer profile-footer">
        <div class="stat-card">
          <div class="stat-card-header no-icon"><span class="stat-label">별풍선</span></div>
          <div class="stat-value" id="profile-balloons"></div>
        </div>
        <div class="stat-card">
          <div class="stat-card-header no-icon"><span class="stat-label">방송시간</span></div>
          <div class="stat-value" id="profile-broadcast"></div>
        </div>
        <div class="stat-card">
          <div class="stat-card-header no-icon"><span class="stat-label">누적시청자</span></div>
          <div class="stat-value" id="profile-viewers"></div>
        </div>
        <div class="stat-card">
          <div class="stat-card-header no-icon"><span class="stat-label">뷰어십</span></div>
          <div class="stat-value" id="profile-viewership"></div>
        </div>
        <div class="stat-card">
          <div class="stat-card-header no-icon"><span class="stat-label">스폰전적</span></div>
          <div class="stat-value is-empty" id="profile-sponsor">-</div>
        </div>
      </div>
    </div>
  </div>
  {% else %}
  {% if not is_team %}
  <div id="rank-summary" class="rank-summary" style="display:none;"></div>
  {% endif %}
  <div id="grid-container"></div>
  {% if not is_team %}
  <div id="fa-bar" class="fa-bar" style="display:none;"></div>
  {% endif %}
  <div class="legend">
    <span><span class="sw tier1"></span>상위 1%</span>
    <span><span class="sw tier5"></span>상위 5%</span>
    <span><span class="sw tier10"></span>상위 10%</span>
    <span><span class="sw excluded"></span>수장/전력외</span>
    <span><span class="bday-icon" aria-hidden="true">🎂</span>생일</span>
  </div>
  {% endif %}

</main>
<script src="{{ logo_prefix }}supabase-config.js"></script>
<script type="application/json" id="page-config">{{ page_config }}</script>
<script src="{{ logo_prefix }}app.js?v={{ app_version }}"></script>
</body>
</html>
